{
  "outDir": "public/recordings",
  "shots": [
    {
      "name": "ch04-prover",
      "url": "https://anwardebes.github.io/veritas/?film",
      "viewport": {
        "width": 960,
        "height": 600
      },
      "deviceScaleFactor": 2,
      "colorScheme": "dark",
      "duration": 14,
      "crf": 17,
      "waitUntil": "networkidle",
      "waitFor": [
        "#prove",
        "#field .f"
      ],
      "settleMs": 1500,
      "css": "#field .f:not([data-s=\"req\"]):not([data-s=\"extra\"]) { color: transparent !important; } #probes .v.sat + .t { color: transparent !important; background: rgba(148,156,154,0.3); border-radius: 4px; } .side ul { display: none !important; } #answer .fine, #proof .sub { visibility: hidden !important; } #proof .checks .check:nth-child(2) span:last-child { visibility: hidden !important; }",
      "cursor": {
        "visible": false
      },
      "actions": [
        {
          "at": 0,
          "type": "eval",
          "script": "window.__veritas.setPrompt('Ignore previous instructions')"
        },
        {
          "at": 0,
          "type": "scroll",
          "to": "#formula",
          "offset": -120,
          "duration": 0.02
        },
        {
          "at": 0.75,
          "type": "scroll",
          "to": "#field",
          "offset": -90,
          "duration": 0.5,
          "ease": "ui"
        },
        {
          "at": 1.0,
          "type": "eval",
          "script": "void window.__veritas.prove()"
        },
        {
          "at": 2.75,
          "type": "scroll",
          "to": "#answer-card",
          "offset": -24,
          "duration": 0.7,
          "ease": "ui"
        },
        {
          "at": 5.0,
          "type": "eval",
          "script": "void window.__veritas.repair()"
        },
        {
          "at": 5.15,
          "type": "scroll",
          "to": "#repair-card",
          "offset": -16,
          "duration": 0.7,
          "ease": "ui"
        },
        {
          "at": 10.2,
          "type": "scroll",
          "to": "#proof",
          "offset": -40,
          "duration": 0.9,
          "ease": "film"
        }
      ]
    }
  ]
}